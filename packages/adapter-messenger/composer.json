{
    "name": "polysource/adapter-messenger",
    "description": "Polysource Admin — Symfony Messenger failed transport data source.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "polysource",
        "symfony-messenger",
        "failed-messages",
        "admin"
    ],
    "homepage": "https://github.com/polysource/polysource",
    "support": {
        "issues": "https://github.com/polysource/polysource/issues",
        "source": "https://github.com/polysource/polysource"
    },
    "require": {
        "php": ">=8.1",
        "polysource/core": "0.1.x-dev",
        "polysource/symfony-bundle": "0.1.x-dev",
        "symfony/config": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/messenger": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Polysource\\Adapter\\Messenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polysource\\Adapter\\Messenger\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
