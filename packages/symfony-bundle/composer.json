{
    "name": "polysource/symfony-bundle",
    "description": "Polysource Admin — Symfony bundle wiring core contracts into Symfony 7.4 (DI, routing, controllers).",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "polysource",
        "symfony-bundle",
        "admin",
        "datasource"
    ],
    "homepage": "https://github.com/polysource/polysource",
    "support": {
        "issues": "https://github.com/polysource/polysource/issues",
        "source": "https://github.com/polysource/polysource"
    },
    "require": {
        "php": "^8.4",
        "polysource/core": "0.1.x-dev",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/phpunit-bridge": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Polysource\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polysource\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
