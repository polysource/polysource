{
    "name": "polysource/filter",
    "description": "Polysource — standalone filter primitive: form/datasource separation, session persistence, mapper/formatter/renderer pipeline, multi-mode UI (integrated, subpanel) with chips bar.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "polysource",
        "filter",
        "symfony",
        "form"
    ],
    "homepage": "https://github.com/polysource/polysource",
    "support": {
        "issues": "https://github.com/polysource/polysource/issues",
        "source": "https://github.com/polysource/polysource"
    },
    "require": {
        "php": ">=8.1",
        "polysource/core": "0.1.x-dev",
        "symfony/config": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/form": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/translation": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/browser-kit": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polysource\\Filter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polysource\\Filter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
