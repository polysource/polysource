{# polysource/filter — "Save current as view" modal.

   Vars:
   - resource_name (string)

   The form action is conditional on the route being wired. Hosts
   register `polysource_saved_view_create` (POST) on their own
   controller; until then the form's action stays `#` so the modal
   renders without crashing on `path()`.

   `polysource_route_exists()` is a Twig function exposed by the
   bundle's SavedViewExtension — it probes the Symfony router so
   the template can degrade gracefully without a hard 500.

   Hosts that want full control:
   1. Implement a controller action that receives the form POST with
      view name + scope + filter state from the URL (the form below
      relays them via hidden inputs).
   2. Override this template at the app level
      (`templates/bundles/PolysourceFilterBundle/saved_view/save_modal.html.twig`)
      to point the form at their controller.

   No CSRF token in the default template — hosts add it to fit
   their security setup.
#}
{%- set _create_route = 'polysource_saved_view_create' -%}
{%- set _form_action = polysource_route_exists(_create_route)
    ? path(_create_route, {resource: resource_name})
    : '#' -%}
{# CSS-selector-safe DOM id derived from resource_name.

   EA entity FQCNs (e.g. `App\Entity\Item`) contain backslashes
   which are valid HTML5 IDs but Bootstrap's data-bs-target
   resolves them via `document.querySelector('#…')`, where `\E`
   triggers a CSS escape sequence and the modal fails to open.
   Surfaced 2026-05-14 by dogfooding round 2.

   `replace({'\\': '-'})` slugs the FQCN into a unique, CSS-safe
   string. Collisions between FQCNs that differ only in
   backslash placement are theoretical but extremely unlikely
   (would require, e.g., `App\Entity\Item` and `App-Entity\Item`
   coexisting as resource names). #}
{%- set _safe_resource_id = resource_name|replace({'\\': '-'})|escape('html_attr') -%}
<div class="modal fade polysource-save-view-modal"
     id="polysource-save-view-modal-{{ _safe_resource_id }}"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ _form_action }}">
                <div class="modal-header">
                    <h5 class="modal-title">
                        {{ 'polysource.saved_views.modal.title'|trans({}, 'PolysourceFilter') }}
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="{{ 'polysource.saved_views.modal.close'|trans({}, 'PolysourceFilter') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="polysource-save-view-name-{{ _safe_resource_id }}">
                            {{ 'polysource.saved_views.modal.name'|trans({}, 'PolysourceFilter') }}
                        </label>
                        <input type="text"
                               class="form-control"
                               id="polysource-save-view-name-{{ _safe_resource_id }}"
                               name="name"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="polysource-save-view-scope-{{ _safe_resource_id }}">
                            {{ 'polysource.saved_views.modal.scope'|trans({}, 'PolysourceFilter') }}
                        </label>
                        <select class="form-select"
                                id="polysource-save-view-scope-{{ _safe_resource_id }}"
                                name="scope">
                            <option value="private" selected>
                                {{ 'polysource.saved_views.scope.private'|trans({}, 'PolysourceFilter') }}
                            </option>
                            {# Hide the TEAM option when no team
                             # resolver is wired — picking it would
                             # otherwise raise an
                             # InvalidArgumentException from the
                             # SavedView constructor (TEAM requires
                             # a non-empty teamId). The bridge's
                             # SavedViewController also falls back to
                             # PRIVATE in that case as a safety net,
                             # but hiding the option avoids a
                             # surprising downgrade for the user. #}
                            {% if polysource_team_scope_supported() %}
                                <option value="team">
                                    {{ 'polysource.saved_views.scope.team'|trans({}, 'PolysourceFilter') }}
                                </option>
                            {% endif %}
                            <option value="public">
                                {{ 'polysource.saved_views.scope.public'|trans({}, 'PolysourceFilter') }}
                            </option>
                        </select>
                    </div>
                    {# Pass the current filter URL to the controller so it can
                       decode the FilterCollection from query parameters. #}
                    <input type="hidden" name="filter_querystring" value="{{ app.request.queryString|default('')|escape('html_attr') }}">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        {{ 'polysource.saved_views.modal.cancel'|trans({}, 'PolysourceFilter') }}
                    </button>
                    <button type="submit" class="btn btn-primary"
                            {% if _form_action == '#' %}disabled title="Host has not wired polysource_saved_view_create route"{% endif %}>
                        {{ 'polysource.saved_views.modal.save'|trans({}, 'PolysourceFilter') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
