{# polysource/filter — saved-views dropdown.

   Vars exposed by SavedViewExtension::renderDropdown():
   - resource_name (string)            current resource scope
   - views (list<SavedView>)           visible views for the user
   - current (?SavedView)              the active default view, if any

   Markup is Bootstrap 5; hosts override at the app level via the
   @PolysourceFilter Twig namespace if they need a different look.

   Apply / save / delete are URL-driven: the dropdown items are plain
   <a href> setting `?view=<id>`; the save modal is a Symfony Form
   POSTing to a host-controlled endpoint. No JS framework required.
#}
<div class="polysource-saved-views dropdown" data-resource="{{ resource_name }}">
    <button type="button"
            class="btn btn-outline-secondary dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        {%- if current is not null -%}
            <span class="polysource-saved-views__current">{{ current.name }}</span>
        {%- else -%}
            {{- 'polysource.saved_views.dropdown.label'|trans({}, 'PolysourceFilter') -}}
        {%- endif -%}
    </button>
    <ul class="dropdown-menu polysource-saved-views__menu">
        {%- if views is empty -%}
            <li>
                <span class="dropdown-item-text text-muted">
                    {{ 'polysource.saved_views.dropdown.empty'|trans({}, 'PolysourceFilter') }}
                </span>
            </li>
        {%- else -%}
            {%- for view in views -%}
                {%- set is_owner = app.user is defined and app.user is not null and app.user.userIdentifier == view.ownerId -%}
                <li class="d-flex align-items-center polysource-saved-views__row">
                    <a class="dropdown-item polysource-saved-views__item flex-grow-1
                              {{ current is not null and current.id == view.id ? 'active' : '' }}"
                       href="?view={{ view.id|url_encode }}"
                       data-view-id="{{ view.id }}">
                        <span class="polysource-saved-views__item-name">{{ view.name }}</span>
                        {%- if view.scope.value != 'private' -%}
                            <span class="badge text-bg-light polysource-saved-views__scope">
                                {{ ('polysource.saved_views.scope.' ~ view.scope.value)|trans({}, 'PolysourceFilter') }}
                            </span>
                            {# Owner attribution — disambiguates which user shared a
                               team/public view when several users have views with
                               the same name on the same resource. Hosts can hide
                               this by overriding the template. #}
                            <small class="text-muted polysource-saved-views__owner">
                                · {{ view.ownerId }}
                            </small>
                        {%- endif -%}
                    </a>
                    {# Delete trigger — only owners can delete (the voter
                       enforces it server-side too). The form POSTs to
                       polysource_saved_view_delete; route is host-defined
                       (the demo wires it via SavedViewController). The
                       form is a sibling of the apply-link, not nested in
                       it (a <form> inside an <a> is invalid HTML). #}
                    {%- if is_owner -%}
                        <form method="post"
                              action="{{ path('polysource_saved_view_delete', {id: view.id}) }}"
                              class="polysource-saved-views__delete-form me-2"
                              onsubmit="return confirm({{ 'polysource.saved_views.delete.confirm'|trans({'%name%': view.name}, 'PolysourceFilter')|json_encode }});">
                            <button type="submit"
                                    class="btn btn-sm btn-link text-danger polysource-saved-views__delete"
                                    aria-label="{{ 'polysource.saved_views.delete.label'|trans({'%name%': view.name}, 'PolysourceFilter') }}">
                                ×
                            </button>
                        </form>
                    {%- endif -%}
                </li>
            {%- endfor -%}
        {%- endif -%}

        <li><hr class="dropdown-divider"></li>
        <li>
            <button type="button"
                    class="dropdown-item polysource-saved-views__save"
                    data-bs-toggle="modal"
                    data-bs-target="#polysource-save-view-modal-{{ resource_name|escape('html_attr') }}">
                {{ 'polysource.saved_views.dropdown.save_current'|trans({}, 'PolysourceFilter') }}
            </button>
        </li>
        {%- if current is not null -%}
            <li>
                {# `?clear-view=1` is consumed server-side by
                 # SavedViewService: it resets the
                 # session-remembered last-used view AND drops every
                 # filter param so the user lands on a fully clean
                 # URL. A bare `href="?"` would only strip the
                 # query string — the session entry would survive,
                 # so on the next page render `defaultFor()` would
                 # resurrect the view as `current` and the user
                 # would think Clear did nothing. #}
                <a class="dropdown-item polysource-saved-views__clear text-danger"
                   href="?clear-view=1">
                    {{ 'polysource.saved_views.dropdown.clear'|trans({}, 'PolysourceFilter') }}
                </a>
            </li>
        {%- endif -%}
    </ul>
</div>

{# The save modal — included once per dropdown render. The host's
   form action / CSRF / fields live in save_modal.html.twig and can
   be overridden independently. #}
{{ include('@PolysourceFilter/saved_view/save_modal.html.twig', {
    resource_name: resource_name,
}) }}
