{
    "name": "@polysource/easyadmin-filter-bridge",
    "description": "Stimulus controller shipped with polysource/easyadmin-filter-bridge — value-only since v0.2.0: exposes the enhanced filters' typed data attributes (step, min_length, include_null, ...) for host-side progressive-enhancement layers.",
    "license": "MIT",
    "private": true,
    "symfony": {
        "controllers": {
            "polysource--filter": {
                "main": "./controllers/polysource_filter_controller.js",
                "name": "polysource--filter",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {}
            },
            "polysource--row-details": {
                "main": "./controllers/row_details_controller.js",
                "name": "polysource--row-details",
                "fetch": "lazy",
                "enabled": true,
                "autoimport": {}
            }
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    },
    "scripts": {
        "test": "vitest run"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "jsdom": "^25.0.0",
        "vitest": "^3.2.6"
    }
}
