{# polysource/easyadmin-filter-bridge — override of
   `@EasyAdmin/crud/includes/_filters_modal.html.twig`.

   Identical to upstream — the only Polysource customisation lives
   inside the AJAX-loaded form template (`crud/filters.html.twig`
   override), which server-renders the filter form into native
   `<details name="polysource-tab">` tabs and `<details>` group
   accordions based on the host's `Polysource::tab(...)` /
   `Polysource::group(...)` markers.

   Since v0.2.0 the layout is fully server-side (no Stimulus
   controller bound to the modal) — see ADR-027 for the rationale.
#}
<div id="modal-filters" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header justify-content-between">
                <twig:ea:Button type="button" size="sm" icon="internal:xmark" data-bs-dismiss="modal" id="modal-clear-button" formtarget="_self">
                    {{ 'filter.button.clear'|trans(domain: 'EasyAdminBundle') }}
                </twig:ea:Button>
                <h5 class="modal-title">
                    <twig:ea:Icon name="internal:filter" /> {{ 'filter.title'|trans(domain: 'EasyAdminBundle') }}
                </h5>
                <twig:ea:Button type="button" variant="primary" size="sm" data-bs-dismiss="modal" class="btn btn-sm btn-primary" id="modal-apply-button" formtarget="_self" icon="internal:check">
                    {{ 'filter.button.apply'|trans(domain: 'EasyAdminBundle') }}
                </twig:ea:Button>
            </div>
            <div class="modal-body p-0">
                {# The filters form will be loaded via AJAX for better performance #}
                {# See @EasyAdmin/default/filters.html.twig template #}
            </div>
        </div>
    </div>
</div>
