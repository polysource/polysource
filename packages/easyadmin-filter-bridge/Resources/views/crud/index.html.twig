{# polysource/easyadmin-filter-bridge — override of @EasyAdmin/crud/index.html.twig

   Injects an "active filters" chips bar above the table on EA index
   pages. The chips bar markup lives in two reusable templates:
     - `crud/_chips_bar.html.twig` — wrapper + iteration
     - `crud/_chip.html.twig`      — single chip body

   Hosts override either independently at the app level via
   `templates/bundles/EasyAdminBundle/crud/_chip.html.twig` (Symfony
   convention) without touching the index template.

   Why two templates instead of one inline macro:
   - A common request is "I just want chips with my company colors";
     overriding `_chip.html.twig` is a 5-line change.
   - Another common request is "I want chips inside the page actions
     row, not above"; overriding `_chips_bar.html.twig` covers that.
   - Splitting them is cheaper than letting hosts overload our index
     and re-implement the chips bar.

   Why `@!EasyAdmin/...`:
   - Our DI extension splices this views path into the `@EasyAdmin`
     namespace at higher priority. The bang-prefix skips the
     override resolution and reaches the upstream file directly,
     preventing an infinite extends loop.
#}
{% extends '@!EasyAdmin/crud/index.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    {# Bundle stylesheet — chips bar, filter tabs/groups, subpanel
       mode. Shipped in `Resources/public/`, published to
       `public/bundles/polysourceeasyadminfilterbridge/` by
       `assets:install` (Symfony Flex runs it on install). No inline
       CSS → host CSP policies don't need `style-src 'unsafe-inline'`
       for the bridge (exception: the per-user hidden-columns rules
       in the `main` block below, which are request-dependent).

       Theming: every colour flows through a `--polysource-*` CSS
       variable — override them from the app stylesheet. To replace
       the stylesheet wholesale, override the `polysource_stylesheets`
       block in a template extending this one. #}
    {% block polysource_stylesheets %}
        <link rel="stylesheet" href="{{ asset('bundles/polysourceeasyadminfilterbridge/polysource-filter-bridge.css') }}">
    {% endblock %}
{% endblock %}

{% block configured_body_contents %}
    {{ parent() }}
    {# Defensive shim for the filter button — kicks in ONLY when
       EasyAdmin's bundled app.js didn't manage to bind the handler
       (Turbo-enabled stacks swap `<body>` without re-firing
       `DOMContentLoaded`, so EA's `#createFilters()` never runs
       again and the button stays disabled). Full rationale in the
       script file. External file (not inline) so host CSP policies
       don't need `script-src 'unsafe-inline'` for the bridge;
       published by `assets:install` like the stylesheet above. #}
    <script src="{{ asset('bundles/polysourceeasyadminfilterbridge/polysource-filter-shim.js') }}" defer></script>
{% endblock %}

{% block main %}
    {# Saved-views dropdown — uses the EA entity FQCN as the
       resourceName so saved views are automatically scoped per
       CrudController without host-side config.

       `saved_views_dropdown` is owned by `polysource/filter`
       (since v0.1.4), a transitive dep of the bridge — so the
       function is always registered when this template renders.
       When the host hasn't configured a SavedViewStorageInterface
       (no Doctrine ORM, or no migration run yet), the function
       returns an empty string and the wrapper div stays
       harmlessly empty. #}
    {% if ea is defined and ea.crud is not null %}
        <div class="ea-filter-saved-views-bar d-flex flex-wrap gap-2 align-items-center mb-2">
            {{ saved_views_dropdown(ea.crud.entityFqcn) }}

            {# Column-visibility toggle (v0.3.0).
               Renders a dropdown with one checkbox per column. Submitting
               POSTs to /admin/polysource/column-preferences/{resource}.

               The column list is computed from the first entity's fields
               (EA exposes the per-row FieldDto collection). If no entities
               are visible (empty table) the dropdown is omitted — without
               an entity row the field list isn't reachable.

               The dropdown is gracefully hidden by CSS when the bridge's
               ColumnPreferenceController isn't wired (no DoctrineBundle /
               no SecurityBundle) — the controller's route returns 404,
               and the dropdown wouldn't be useful anyway. Hosts in that
               state see no UI clutter. #}
            {# Defensive route-existence gate (since v0.5.4). The
               column-visibility dropdown POSTs to
               `polysource_column_preferences_update` — if that route
               isn't registered (host hasn't imported the bridge's
               routes, or v0.5.4's `Bundle::boot()` auto-import is
               disabled), don't render the dropdown rather than 500
               on every admin index page. Surfaced 2026-05-14 by
               dogfooding round 2: without this guard, fresh installs
               crash the entire index page with "Unable to generate
               a URL for the named route" before v0.5.4's auto-route
               fix landed. #}
            {% if entities is defined and entities|length > 0
               and polysource_route_exists('polysource_column_preferences_update') %}
                {% set polysource_first_entity = entities|first %}
                {% set polysource_resource_key = ea.crud.entityFqcn %}
                {% set polysource_hidden = polysource_hidden_columns(polysource_resource_key) %}

                <div class="dropdown ea-column-visibility">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            id="polysource-column-visibility-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        {# Unicode glyph instead of an EA-shipped icon —
                           EA's icon set varies across versions and
                           doesn't reliably ship `internal:columns`. The
                           character is decorative; the label provides
                           the screen-reader-readable text. #}
                        <span aria-hidden="true">⊞</span>
                        {{ 'polysource.columns.toggle'|trans({}, 'PolysourceEasyAdminFilterBridge') }}
                        {% if polysource_hidden|length > 0 %}
                            <span class="badge bg-primary ms-1">{{ polysource_hidden|length }}</span>
                        {% endif %}
                    </button>
                    <form method="post"
                          action="{{ path('polysource_column_preferences_update', {resource: polysource_resource_key}) }}"
                          class="dropdown-menu p-3 ea-column-visibility__menu"
                          aria-labelledby="polysource-column-visibility-toggle">
                        <input type="hidden" name="_token" value="{{ csrf_token('polysource_column_preferences_' ~ polysource_resource_key) }}">
                        {% for field in polysource_first_entity.fields %}
                            {% set property = field.property %}
                            {% set is_hidden = property in polysource_hidden %}
                            <div class="form-check">
                                <input type="hidden" name="columns[]" value="{{ property }}">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="visible[]"
                                       value="{{ property }}"
                                       id="polysource-col-{{ property }}"
                                       {% if not is_hidden %}checked{% endif %}>
                                <label class="form-check-label" for="polysource-col-{{ property }}">
                                    {{ field.label|default(property|humanize) }}
                                </label>
                            </div>
                        {% endfor %}
                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button type="submit" class="btn btn-sm btn-primary">
                                {{ 'polysource.columns.apply'|trans({}, 'PolysourceEasyAdminFilterBridge') }}
                            </button>
                        </div>
                    </form>
                </div>

                {# Server-rendered CSS that hides cells for each property
                   in the user's hidden list. EA emits `[data-column="X"]`
                   on every <th> and <td>, so a single selector per
                   hidden column blanks the entire column without
                   touching EA's table iteration. #}
                {% if polysource_hidden|length > 0 %}
                    <style>
                        {% for property in polysource_hidden %}
                        [data-column="{{ property|e('css') }}"] { display: none !important; }
                        {% endfor %}
                    </style>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}

    {% set applied_filters = ea.request.query.all['filters']|default([]) %}
    {{ include('@EasyAdmin/crud/_chips_bar.html.twig', {
        applied_filters: applied_filters,
    }) }}

    {{ parent() }}
{% endblock main %}
