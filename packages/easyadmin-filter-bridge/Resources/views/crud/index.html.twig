{# polysource/easyadmin-filter-bridge — override of @EasyAdmin/crud/index.html.twig

   Injects an "active filters" chips bar above the table on EA index
   pages. The chips bar markup lives in two reusable templates:
     - `crud/_chips_bar.html.twig` — wrapper + iteration
     - `crud/_chip.html.twig`      — single chip body

   Hosts override either independently at the app level via
   `templates/bundles/EasyAdminBundle/crud/_chip.html.twig` (Symfony
   convention) without touching the index template.

   Why two templates instead of one inline macro:
   - A common request is "I just want chips with my company colors";
     overriding `_chip.html.twig` is a 5-line change.
   - Another common request is "I want chips inside the page actions
     row, not above"; overriding `_chips_bar.html.twig` covers that.
   - Splitting them is cheaper than letting hosts overload our index
     and re-implement the chips bar.

   Why `@!EasyAdmin/...`:
   - Our DI extension splices this views path into the `@EasyAdmin`
     namespace at higher priority. The bang-prefix skips the
     override resolution and reaches the upstream file directly,
     preventing an infinite extends loop.
#}
{% extends '@!EasyAdmin/crud/index.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    <style>
        /* polysource/easyadmin-filter-bridge — chips bar (default).
           Hosts can override by shipping a custom CSS file before
           this one in their twig.form_themes / asset stack. */
        .ea-filter-chips-bar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem 0.75rem;
            margin-bottom: 1rem;
            padding: 0.5rem 0.75rem;
            background: var(--bs-tertiary-bg, #f5f5f5);
            border: 1px solid var(--bs-border-color, #dee2e6);
            border-radius: 0.375rem;
        }
        .ea-filter-chips-bar__heading {
            font-size: 0.875rem;
            color: var(--bs-secondary-color, #6c757d);
            font-weight: 500;
            margin-right: 0.25rem;
        }
        .ea-filter-chips-bar__list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.375rem;
            flex: 1 1 auto;
        }
        .ea-filter-chips-bar__clear {
            font-size: 0.8125rem;
            color: var(--bs-secondary-color, #6c757d);
            text-decoration: underline;
            margin-left: auto;
            white-space: nowrap;
        }
        .ea-filter-chips-bar__clear:hover {
            color: var(--bs-danger, #dc3545);
        }

        /* Single chip — pill shape with subtle EA-styled border. */
        .ea-filter-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.625rem;
            background: var(--bs-body-bg, #fff);
            border: 1px solid var(--bs-border-color, #dee2e6);
            border-radius: 999px;
            font-size: 0.8125rem;
            line-height: 1.4;
            box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
        }
        .ea-filter-chip__label {
            font-weight: 600;
            color: var(--bs-emphasis-color, #212529);
        }
        .ea-filter-chip__sep {
            color: var(--bs-secondary-color, #6c757d);
            margin: 0 0.125rem;
        }
        .ea-filter-chip__value {
            color: var(--bs-body-color, #212529);
        }
        .ea-filter-chip__operator {
            color: var(--bs-secondary-color, #6c757d);
            font-style: italic;
            margin-right: 0.25rem;
        }
        .ea-filter-chip__arrow {
            color: var(--bs-secondary-color, #6c757d);
            margin: 0 0.125rem;
        }
        .ea-filter-chip__remove {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.125rem;
            height: 1.125rem;
            margin-left: 0.25rem;
            padding: 0;
            background: transparent;
            border: 0;
            border-radius: 50%;
            color: var(--bs-secondary-color, #6c757d);
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            /* Reset <a> defaults — the X is now an anchor so the
               server-driven fallback works on EA 4 + Sf 5.4 stacks
               that can't load the Stimulus controller. */
            text-decoration: none;
        }
        .ea-filter-chip__remove:hover,
        .ea-filter-chip__remove:focus {
            background: var(--bs-danger, #dc3545);
            color: #fff;
            outline: none;
        }

        /* ─── Modal body padding (EA strips it via .p-0; we add ours
             back so the form doesn't kiss the modal edges). ─── */
        #modal-filters .modal-body {
            padding: 1rem 1.25rem !important;
        }

        /* ─── EA-style tabs (underline, no boxes) — server-rendered
             via `<details name="polysource-tab">` exclusive accordion
             (HTML Living Standard, Chrome 120+ / Safari 17.2+ /
             Firefox 121+ since Dec 2023). Older browsers gracefully
             fall back to "every tab independently expandable".

             Layout — horizontal tab strip + pane below.

             Each `<details>` is block-level by default, so multiple
             siblings stack vertically — that's NOT what an EA-style
             tab strip looks like. Surfaced 2026-05-14 dogfooding
             round 3 (friction C4): with 4 tabs declared, the subpanel
             rendered them one per row instead of side-by-side.

             Fix — flex container on the form, `display: contents` on
             the `<details>` so its `<summary>` + pane act as direct
             children of the flex parent. The summaries lay out in a
             horizontal row (via inline-block + auto-wrap); the open
             tab's pane wraps to a full-width new row via
             `flex-basis: 100%; order: 999;`. Closed tabs' panes stay
             hidden via the native `<details>:not([open])` selector.

             Zero JS — works on browsers that support
             `<details name="">` (mutual exclusion); falls back to
             "every tab independently expandable" on older browsers
             with the same horizontal strip layout. ─── */
        /* Scope the flex layout to the tab strip only — applying it
           to the whole form would break the col-12 row layout of the
           ungrouped filters above the tabs. */
        .polysource-filter-tabs-strip {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            row-gap: 0;
        }
        details.polysource-filter-tab {
            /* `display: contents` removes the `<details>` from the
               layout tree so its children participate in the form's
               flex layout directly. The native open/close toggle on
               summary click is HTML-level, not CSS-level, so it
               keeps working. */
            display: contents;
            margin: 0;
            border: 0;
            background: transparent;
        }
        details.polysource-filter-tab > summary {
            list-style: none;
            cursor: pointer;
            padding: 0.5rem 0;
            margin: 0;
            display: inline-block;
            color: var(--bs-secondary-color, #6c757d);
            font-weight: 500;
            border-bottom: 2px solid transparent;
            transition: color 0.15s, border-color 0.15s;
            user-select: none;
            line-height: 1.5;
        }
        details.polysource-filter-tab > summary::-webkit-details-marker {
            display: none;
        }
        details.polysource-filter-tab > summary::marker {
            content: '';
        }
        details.polysource-filter-tab > summary:hover {
            color: var(--bs-emphasis-color, #212529);
        }
        /* Open state: same font-weight as closed (avoids baseline shift),
           differentiated by color + underline — matches EA's flat-tab look. */
        details.polysource-filter-tab[open] > summary {
            color: var(--bs-primary, #4f46e5);
            border-bottom-color: var(--bs-primary, #4f46e5);
        }
        /* Per-tab applied-filter counter — server-rendered by the
           filters.html.twig override only when at least one filter in
           the tab is currently applied (its property appears in the
           URL's `filters[...]` slice). Pill in primary color so the
           user sees at a glance which tabs hold active filters
           without clicking through them. */
        details.polysource-filter-tab > summary .polysource-filter-tab__count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.125rem;
            height: 1.125rem;
            padding: 0 0.375rem;
            margin-left: 0.5rem;
            border-radius: 999px;
            background: var(--bs-primary, #4f46e5);
            color: #fff;
            font-size: 0.6875rem;
            font-weight: 700;
            line-height: 1;
            vertical-align: middle;
        }
        /* Sibling tabs separated horizontally. The `+` selector
           targets a summary whose `<details>` is preceded by another
           `<details>` tab — i.e. every tab except the first.
           Because both `<details>` are `display: contents`, their
           summaries are flex siblings in the form, so the adjacent
           selector matches across the (collapsed) details boundary. */
        details.polysource-filter-tab + details.polysource-filter-tab > summary {
            margin-left: 1.5rem;
        }
        /* Open pane → wraps to its own full-width row below the
           tab strip via `flex-basis: 100%`. `order: 999` pins it
           after every summary regardless of source order. Underline
           strip separating tabs from content sits on the pane's
           top border. */
        details.polysource-filter-tab > .polysource-filter-tab__pane {
            flex: 0 0 100%;
            order: 999;
            padding: 1rem 0 0 0.25rem;
            margin-top: 0.5rem;
            border-top: 1px solid var(--bs-border-color, #dee2e6);
        }

        /* ─── Group sections (subtle, EA-aligned) ─── */
        details.polysource-filter-group {
            margin: 0 0 0.75rem 0;
            padding-left: 0.5rem;
            border: 0;
            background: transparent;
        }
        details.polysource-filter-group > summary {
            list-style: none;
            cursor: pointer;
            padding: 0.25rem 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            user-select: none;
        }
        details.polysource-filter-group > summary::-webkit-details-marker {
            display: none;
        }
        details.polysource-filter-group > summary::before {
            content: '';
            display: inline-block;
            width: 0.5em;
            height: 0.5em;
            border-right: 2px solid var(--bs-secondary-color, #6c757d);
            border-bottom: 2px solid var(--bs-secondary-color, #6c757d);
            transform: rotate(-45deg);
            transition: transform 0.2s;
            margin-right: 0.25rem;
            opacity: 0.55;
        }
        details.polysource-filter-group[open] > summary::before {
            transform: rotate(45deg);
        }
        details.polysource-filter-group > summary > strong {
            color: var(--bs-secondary-color, #6c757d);
            font-size: 0.6875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            flex: 1;
        }
        /* Per-group applied-filter counter — same server-rendered
           contract as the tab counter. Bold + count in primary color. */
        details.polysource-filter-group > summary > .polysource-filter-group__count {
            color: var(--bs-primary, #4f46e5);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0;
            background: transparent;
            margin-left: 0.5rem;
        }
        details.polysource-filter-group .polysource-filter-group__body {
            padding-left: 0.25rem;
        }

        /* ─── First filter inside a tab pane / group body has no
             top border (the EA filter form theme sets one between
             siblings; we strip it on the first child to avoid a
             double line right under the group header). ─── */
        .polysource-filter-tab__pane > .filter-field:first-child,
        .polysource-filter-group__body > .filter-field:first-child {
            border-top: 0 !important;
        }
    </style>
{% endblock %}

{% block configured_body_contents %}
    {{ parent() }}
    {# Defensive shim — kicks in ONLY when EasyAdmin's bundled
     # app.js didn't manage to bind the filter-button handler.
     # That's the case in Turbo-enabled stacks where navigation
     # swaps `<body>` without re-firing `DOMContentLoaded`, so
     # `#createFilters()` never runs again, the button stays
     # `class="disabled"`, and clicking opens an empty modal.
     #
     # If EA's app DID init (`window.EasyAdminApp` is defined and
     # the button is no longer disabled), we yield to it. Earlier
     # versions of this script bound a second click handler
     # unconditionally, racing with EA's: both fetches ran and the
     # second clobbered the modal AFTER `#createFilterToggles()`
     # had already attached the auto-tick `change` listener — the
     # user saw filters silently fail to apply because their
     # checkbox never auto-ticked.
     #}
    <script>
    (function () {
        const init = () => {
            const btn = document.querySelector('.datagrid-filters .action-filters-button');
            if (!btn || btn.dataset.polysourceBound === '1') return;

            // Yield to EA's app.js when it's already wired the
            // button. Two signals (either is sufficient): the
            // `disabled` class is removed by `#createFilters()`,
            // and `window.EasyAdminApp` is the App instance.
            const eaWiredButton = !btn.classList.contains('disabled')
                || (typeof window !== 'undefined' && window.EasyAdminApp);
            if (eaWiredButton) {
                btn.dataset.polysourceBound = '1';
                return;
            }

            const target = btn.getAttribute('data-bs-target');
            const modal = target ? document.querySelector(target) : null;
            const dataHref = btn.getAttribute('data-href') || btn.getAttribute('href');
            if (!modal || !dataHref) return;

            btn.classList.remove('disabled');
            btn.setAttribute('href', dataHref);
            btn.removeAttribute('data-href');
            btn.dataset.polysourceBound = '1';

            btn.addEventListener('click', (event) => {
                const body = modal.querySelector('.modal-body');
                if (!body) return;
                body.innerHTML = '<div class="text-center p-4 text-muted"><i class="fas fa-spinner fa-spin"></i></div>';
                fetch(dataHref, { credentials: 'same-origin' })
                    .then((r) => r.text())
                    .then((html) => {
                        body.innerHTML = html;
                        // Re-bind EA's auto-tick listener so users
                        // typing in a value field tick the matching
                        // checkbox automatically. Mirrors EA's
                        // `#createFilterToggles` body since we
                        // can't call the private method directly.
                        body.querySelectorAll('form[data-ea-filters-form-id]').forEach((form) => {
                            if (form.dataset.polysourceAutotick === '1') return;
                            form.dataset.polysourceAutotick = '1';
                            form.addEventListener('change', (e) => {
                                const t = e.target;
                                if (!t || t.classList.contains('filter-checkbox')) return;
                                const field = t.closest('.filter-field');
                                if (!field) return;
                                const cb = field.querySelector('.filter-checkbox');
                                if (cb && !cb.checked) cb.checked = true;
                            });
                        });
                    })
                    .catch((err) => {
                        body.innerHTML = '<div class="alert alert-danger m-3">Failed to load filters: ' + (err && err.message ? err.message : 'unknown error') + '</div>';
                    });
                event.preventDefault();
            });
        };
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
        document.addEventListener('turbo:load', init);
    })();
    </script>
{% endblock %}

{% block main %}
    {# Saved-views dropdown — uses the EA entity FQCN as the
       resourceName so saved views are automatically scoped per
       CrudController without host-side config.

       `saved_views_dropdown` is owned by `polysource/filter`
       (since v0.1.4), a transitive dep of the bridge — so the
       function is always registered when this template renders.
       When the host hasn't configured a SavedViewStorageInterface
       (no Doctrine ORM, or no migration run yet), the function
       returns an empty string and the wrapper div stays
       harmlessly empty. #}
    {% if ea is defined and ea.crud is not null %}
        <div class="ea-filter-saved-views-bar d-flex flex-wrap gap-2 align-items-center mb-2">
            {{ saved_views_dropdown(ea.crud.entityFqcn) }}

            {# Column-visibility toggle (v0.3.0).
               Renders a dropdown with one checkbox per column. Submitting
               POSTs to /admin/polysource/column-preferences/{resource}.

               The column list is computed from the first entity's fields
               (EA exposes the per-row FieldDto collection). If no entities
               are visible (empty table) the dropdown is omitted — without
               an entity row the field list isn't reachable.

               The dropdown is gracefully hidden by CSS when the bridge's
               ColumnPreferenceController isn't wired (no DoctrineBundle /
               no SecurityBundle) — the controller's route returns 404,
               and the dropdown wouldn't be useful anyway. Hosts in that
               state see no UI clutter. #}
            {# Defensive route-existence gate (since v0.5.4). The
               column-visibility dropdown POSTs to
               `polysource_column_preferences_update` — if that route
               isn't registered (host hasn't imported the bridge's
               routes, or v0.5.4's `Bundle::boot()` auto-import is
               disabled), don't render the dropdown rather than 500
               on every admin index page. Surfaced 2026-05-14 by
               dogfooding round 2: without this guard, fresh installs
               crash the entire index page with "Unable to generate
               a URL for the named route" before v0.5.4's auto-route
               fix landed. #}
            {% if entities is defined and entities|length > 0
               and polysource_route_exists('polysource_column_preferences_update') %}
                {% set polysource_first_entity = entities|first %}
                {% set polysource_resource_key = ea.crud.entityFqcn %}
                {% set polysource_hidden = polysource_hidden_columns(polysource_resource_key) %}

                <div class="dropdown ea-column-visibility">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            id="polysource-column-visibility-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        {# Unicode glyph instead of an EA-shipped icon —
                           EA's icon set varies across versions and
                           doesn't reliably ship `internal:columns`. The
                           character is decorative; the label provides
                           the screen-reader-readable text. #}
                        <span aria-hidden="true">⊞</span>
                        {{ 'polysource.columns.toggle'|trans({}, 'PolysourceEasyAdminFilterBridge') }}
                        {% if polysource_hidden|length > 0 %}
                            <span class="badge bg-primary ms-1">{{ polysource_hidden|length }}</span>
                        {% endif %}
                    </button>
                    <form method="post"
                          action="{{ path('polysource_column_preferences_update', {resource: polysource_resource_key}) }}"
                          class="dropdown-menu p-3 ea-column-visibility__menu"
                          aria-labelledby="polysource-column-visibility-toggle">
                        <input type="hidden" name="_token" value="{{ csrf_token('polysource_column_preferences_' ~ polysource_resource_key) }}">
                        {% for field in polysource_first_entity.fields %}
                            {% set property = field.property %}
                            {% set is_hidden = property in polysource_hidden %}
                            <div class="form-check">
                                <input type="hidden" name="columns[]" value="{{ property }}">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="visible[]"
                                       value="{{ property }}"
                                       id="polysource-col-{{ property }}"
                                       {% if not is_hidden %}checked{% endif %}>
                                <label class="form-check-label" for="polysource-col-{{ property }}">
                                    {{ field.label|default(property|humanize) }}
                                </label>
                            </div>
                        {% endfor %}
                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button type="submit" class="btn btn-sm btn-primary">
                                {{ 'polysource.columns.apply'|trans({}, 'PolysourceEasyAdminFilterBridge') }}
                            </button>
                        </div>
                    </form>
                </div>

                {# Server-rendered CSS that hides cells for each property
                   in the user's hidden list. EA emits `[data-column="X"]`
                   on every <th> and <td>, so a single selector per
                   hidden column blanks the entire column without
                   touching EA's table iteration. #}
                {% if polysource_hidden|length > 0 %}
                    <style>
                        {% for property in polysource_hidden %}
                        [data-column="{{ property|e('css') }}"] { display: none !important; }
                        {% endfor %}
                    </style>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}

    {% set applied_filters = ea.request.query.all['filters']|default([]) %}
    {{ include('@EasyAdmin/crud/_chips_bar.html.twig', {
        applied_filters: applied_filters,
    }) }}

    {{ parent() }}
{% endblock main %}
