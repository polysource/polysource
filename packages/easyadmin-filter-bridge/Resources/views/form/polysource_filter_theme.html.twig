{# polysource/easyadmin-filter-bridge — Form theme.

   STRICT delegation pattern: every `polysource_enhanced_*_filter_widget`
   block renders its content via the corresponding upstream block
   (`form_widget_compound`, `ea_numeric_filter_widget`,
   `ea_datetime_filter_widget`, `choice_widget`) and only WRAPS that
   output in a `<div>` carrying:

   - `data-controller="polysource--filter"` so the Stimulus controller
     binds to the wrapper.
   - `data-polysource--filter-{option}-value="…"` for each option the
     enhanced FormType exposes via `buildView()` (quick_ranges,
     min_length, step, include_null, chip_display, placeholder,
     comparisons).
   - Optional appended UI elements (quick-range buttons) — the
     controller reads `data-action` on each to dispatch the right
     handler.

   By delegating to the upstream blocks, host applications that have
   customized `@EasyAdmin/crud/form_theme.html.twig` (or any of the
   inherited blocks) automatically inherit those customizations — the
   bridge never duplicates the upstream markup. #}

{# Boolean filter inherits from ChoiceType, not ComparisonFilterType,
   so it falls back to `choice_widget`. #}
{%- block polysource_enhanced_boolean_filter_widget -%}
    <div class="polysource-filter polysource-filter--boolean"
         data-controller="polysource--filter"
         data-polysource--filter-include-null-value="{{ include_null|default(false) ? 'true' : 'false' }}">
        {{- block('choice_widget') -}}
    </div>
{%- endblock -%}

{# NumericFilterType has a dedicated upstream block that already handles
   the value2 d-none toggle — we just wrap it. #}
{%- block polysource_enhanced_numeric_filter_widget -%}
    <div class="polysource-filter polysource-filter--numeric"
         data-controller="polysource--filter"
         data-polysource--filter-step-value="{{ step|default(0) }}"
         data-polysource--filter-quick-ranges-value="{{ quick_ranges|default([])|json_encode|e('html_attr') }}">
        {{- block('ea_numeric_filter_widget') -}}
        {%- if quick_ranges|default([])|length > 0 -%}
            <div class="polysource-quick-ranges d-flex flex-wrap gap-1 mt-2"
                 role="group"
                 aria-label="{{ 'polysource.filter.quick_ranges.label'|trans({}, 'PolysourceEasyAdminFilterBridge') }}">
                {%- for range in quick_ranges -%}
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary polysource-quick-range"
                            data-action="polysource--filter#applyQuickRange"
                            data-polysource--filter-min-param="{{ range.min is defined and range.min is not null ? range.min : '' }}"
                            data-polysource--filter-max-param="{{ range.max is defined and range.max is not null ? range.max : '' }}">{{ range.label|trans({}, 'PolysourceEasyAdminFilterBridge') }}</button>
                {%- endfor -%}
            </div>
        {%- endif -%}
    </div>
{%- endblock -%}

{# DateTimeFilterType has its own upstream block too. Since v0.2.0
   no extra UI is appended — the `presets` + `show_clear` options
   (JS-driven preset buttons + per-filter clear button) were removed
   per ADR-027 + ADR-028. HTML5 native date pickers + EA's Reset
   cover the same ground. #}
{%- block polysource_enhanced_datetime_filter_widget -%}
    <div class="polysource-filter polysource-filter--datetime"
         data-controller="polysource--filter">
        {{- block('ea_datetime_filter_widget') -}}
    </div>
{%- endblock -%}

{# Text/Comparison/Choice/Array/Entity have no upstream-specific filter
   block — they use Symfony Form's default `form_widget_compound` (which
   iterates children via `form_row` for proper Bootstrap spacing). #}

{%- block polysource_enhanced_text_filter_widget -%}
    <div class="polysource-filter polysource-filter--text"
         data-controller="polysource--filter"
         data-polysource--filter-min-length-value="{{ min_length|default(0) }}">
        {{- block('form_widget_compound') -}}
    </div>
{%- endblock -%}

{%- block polysource_enhanced_comparison_filter_widget -%}
    <div class="polysource-filter polysource-filter--comparison"
         data-controller="polysource--filter"
         data-polysource--filter-comparisons-value="{{ comparisons|default([])|json_encode|e('html_attr') }}">
        {{- block('form_widget_compound') -}}
    </div>
{%- endblock -%}

{%- block polysource_enhanced_choice_filter_widget -%}
    <div class="polysource-filter polysource-filter--choice"
         data-controller="polysource--filter"
         data-polysource--filter-inline-value="{{ inline|default(false) ? 'true' : 'false' }}">
        {{- block('form_widget_compound') -}}
    </div>
{%- endblock -%}

{%- block polysource_enhanced_array_filter_widget -%}
    <div class="polysource-filter polysource-filter--array"
         data-controller="polysource--filter"
         data-polysource--filter-chip-display-value="{{ chip_display|default(false) ? 'true' : 'false' }}">
        {{- block('form_widget_compound') -}}
    </div>
{%- endblock -%}

{%- block polysource_enhanced_entity_filter_widget -%}
    <div class="polysource-filter polysource-filter--entity"
         data-controller="polysource--filter"
         data-polysource--filter-placeholder-value="{{ placeholder|default('')|e('html_attr') }}">
        {{- block('form_widget_compound') -}}
    </div>
{%- endblock -%}
