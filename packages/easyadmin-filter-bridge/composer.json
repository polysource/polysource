{
    "name": "polysource/easyadmin-filter-bridge",
    "description": "Polysource — drop-in package that enriches EasyAdmin v5 filters (date presets, ranges, multi-select, session persistence, chips) without forking EasyAdmin.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "polysource",
        "easyadmin",
        "filter",
        "symfony",
        "admin"
    ],
    "homepage": "https://github.com/polysource/polysource",
    "support": {
        "issues": "https://github.com/polysource/polysource/issues",
        "source": "https://github.com/polysource/polysource"
    },
    "require": {
        "php": "^8.1",
        "easycorp/easyadmin-bundle": "^4.24 || ^5.0",
        "polysource/filter": "0.1.x-dev",
        "symfony/config": "^5.4 || ^6.4 || ^7.4",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.4",
        "symfony/form": "^5.4 || ^6.4 || ^7.4",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.4"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/orm": "^2.20 || ^3.6",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^5.4 || ^6.4 || ^7.4",
        "symfony/dom-crawler": "^5.4 || ^6.4 || ^7.4",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.4",
        "symfony/security-bundle": "^5.4 || ^6.4 || ^7.4",
        "symfony/twig-bundle": "^5.4 || ^6.4 || ^7.4"
    },
    "autoload": {
        "psr-4": {
            "Polysource\\EasyAdminFilterBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polysource\\EasyAdminFilterBridge\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
