{# Renders a chips bar with one removable pill per active filter
 # criterion. Includes a "Clear all" link when at least one chip is
 # active. Hosts override this template by registering a higher-priority
 # path under `@Polysource`. #}
{% set chips = polysource_active_filters(context) %}
{% if chips|length > 0 %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-polysource-filter-chips>
        <span class="text-body-secondary small me-1">Active:</span>
        {% for chip in chips %}
            <a href="{{ chip.removeUrl }}"
               class="badge text-bg-light border d-inline-flex align-items-center gap-1 text-decoration-none"
               data-polysource-chip-property="{{ chip.name }}"
               title="Remove filter">
                <span class="text-body-secondary">{{ chip.label }}</span>
                <span>{{ chip.operator }}</span>
                <strong>{{ chip.displayValue }}</strong>
                <span class="text-body-secondary ms-1" aria-hidden="true">×</span>
            </a>
        {% endfor %}
        <a href="{{ polysource_clear_filters_url(context) }}"
           class="small text-decoration-none ms-2"
           data-polysource-clear-filters>
            Clear all
        </a>
    </div>
{% endif %}
