<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{{ resource.label|default('Polysource') }}{% endblock %}</title>
    {# Bootstrap 5 CDN. Add an `integrity=` SRI hash before publishing
     # the theme — pinning a version without one trusts jsdelivr never
     # to be compromised. Verify the hash from
     # https://www.jsdelivr.com/package/npm/bootstrap before changing. #}
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-body-tertiary">
    {% include '@Polysource/_navigation.html.twig' %}

    <main class="container py-4">
        {% include '@Polysource/_flash.html.twig' ignore missing %}

        {% block content %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}
</body>
</html>
