<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{{ resource.label|default('Polysource') }}{% endblock %}</title>
    {# Bootstrap 5 CDN. Add an `integrity=` SRI hash before publishing
     # the theme — pinning a version without one trusts jsdelivr never
     # to be compromised. Verify the hash from
     # https://www.jsdelivr.com/package/npm/bootstrap before changing. #}
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-body-tertiary">
    {# `block navigation` wraps an `embed` so hosts can either
     # override the whole nav (block navigation) or surgically tweak
     # one slot (block nav_brand / nav_links / nav_actions / etc.). #}
    {% block navigation %}
        {% embed '@Polysource/_navigation.html.twig' %}
            {% block nav_brand %}{{ parent() }}{% endblock %}
            {% block nav_resource_indicator %}{{ parent() }}{% endblock %}
            {% block nav_links %}{{ parent() }}{% endblock %}
            {% block nav_actions %}{{ parent() }}{% endblock %}
        {% endembed %}
    {% endblock %}

    <main class="container py-4">
        {% block flash_messages %}
            {% include '@Polysource/_flash.html.twig' ignore missing %}
        {% endblock %}

        {% block content_header %}{% endblock %}

        {% block content %}{% endblock %}

        {% block content_footer %}{% endblock %}
    </main>

    {# Cmd+K cross-resource palette — rendered when polysource/search
     # is installed (its bundle ships the template under
     # `@PolysourceSearch`). Hosts without the package get nothing
     # here thanks to `ignore missing`, so the layout stays usable
     # without polysource/search. #}
    {% block search_palette %}
        {% include '@PolysourceSearch/_palette.html.twig' ignore missing %}
    {% endblock %}

    {# Bootstrap 5 JS bundle (Popper.js included) — required by the
     # saved-views dropdown (`data-bs-toggle="dropdown"`), the filters
     # modal (`data-bs-toggle="modal"`), the bulk-action confirmation
     # popovers, and any host-added tooltip. Loaded BEFORE the host's
     # `javascripts` block so hosts can attach their own listeners on
     # top of Bootstrap's data API.
     #
     # Hosts wrapping polysource pages in their own chrome (cf. the
     # `polysource.layout_template` override + the
     # `wrapping-in-easyadmin-chrome.md` cookbook) typically don't
     # extend this layout — they extend their host base directly and
     # bring their own asset pipeline.
     #
     # Add an `integrity=` SRI hash before publishing the theme —
     # pinning a version without one trusts jsdelivr never to be
     # compromised. Verify the hash from
     # https://www.jsdelivr.com/package/npm/bootstrap before changing. #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"
            defer></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
