{# Variables: value, field, record #}
{% if value %}
    <span class="badge text-bg-success polysource-field polysource-field-boolean" data-polysource-bool="true">Yes</span>
{% else %}
    <span class="badge text-bg-secondary polysource-field polysource-field-boolean" data-polysource-bool="false">No</span>
{% endif %}
