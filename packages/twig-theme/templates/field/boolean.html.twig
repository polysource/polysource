{# Variables: value, field, record #}
{% if value %}
    <span class="badge text-bg-success polysource-field polysource-field-boolean" data-polysource-bool="true">{{ 'polysource.field.boolean.yes'|trans({}, 'Polysource') }}</span>
{% else %}
    <span class="badge text-bg-secondary polysource-field polysource-field-boolean" data-polysource-bool="false">{{ 'polysource.field.boolean.no'|trans({}, 'Polysource') }}</span>
{% endif %}
