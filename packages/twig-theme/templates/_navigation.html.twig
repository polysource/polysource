{# Top navigation. Hosts can override any block to customise the
 # brand, the inline resource path, the centre links menu, or the
 # right-aligned actions area (search box, user menu, etc.). All
 # blocks are optional — the default markup is what shipped before. #}
<nav class="navbar bg-dark navbar-dark border-bottom shadow-sm" data-polysource-nav>
    <div class="container d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-3 me-auto">
            {% block nav_brand %}
                <span class="navbar-brand mb-0 h1">Polysource</span>
            {% endblock %}
            {% block nav_resource_indicator %}
                {% if resource is defined and resource %}
                    <span class="navbar-text small text-body-secondary">
                        /admin/{{ resource.name }}
                    </span>
                {% endif %}
            {% endblock %}
        </div>

        {% block nav_links %}{% endblock %}

        <div class="d-flex align-items-center gap-2">
            {% block nav_actions %}{% endblock %}
        </div>
    </div>
</nav>
