{% extends polysource_layout|default('@Polysource/layout.html.twig') %}

{% block title %}{{ resource.label }}{% endblock %}

{% block content %}
    {% set route_prefix = 'polysource_' ~ resource.name|replace({'-': '_'}) %}

    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-0">{{ resource.label }}</h1>
            <small class="text-body-secondary" data-polysource-resource="{{ resource.name }}">
                {{ resource.name }}
            </small>
        </div>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            {% if polysource_saved_views_supported() %}
                {{ saved_views_dropdown(resource.name) }}
            {% endif %}

            {% if bulk_actions is defined and bulk_actions|length > 0 %}
                <div class="d-flex gap-2 flex-wrap" data-polysource-bulk-toolbar>
                    {% for action in bulk_actions %}
                        <form method="POST"
                              action="{{ path(route_prefix ~ '_bulk_action', {resourceName: resource.name, action: action.name}) }}"
                              onsubmit="return confirm('Run “{{ action.label|e('js') }}” on every record? This cannot be undone.');"
                              class="d-inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('polysource_action') }}">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-{{ action.name == 'purge' ? 'danger' : 'primary' }}"
                                    data-polysource-action="bulk-{{ action.name }}">
                                {{ action.label }}
                            </button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </header>

    {% include '@Polysource/_filters_form.html.twig' ignore missing %}
    {% include '@Polysource/_filter_chips.html.twig' ignore missing %}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        {% for field in fields %}
                            <th scope="col">{{ field.label|default(field.property) }}</th>
                        {% endfor %}
                        <th scope="col" class="text-end">&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in page.items %}
                        <tr>
                            {% for field in fields %}
                                <td>
                                    {% include field.template|default('@Polysource/field/generic.html.twig')
                                        with {value: record.get(field.property), field: field, record: record}
                                        only
                                    %}
                                </td>
                            {% endfor %}
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path(route_prefix ~ '_detail', {resourceName: resource.name, id: record.identifier}) }}"
                                       class="btn btn-outline-secondary"
                                       data-polysource-action="detail">
                                        Detail
                                    </a>
                                    {% for action in inline_actions %}
                                        <form method="POST"
                                              action="{{ path(route_prefix ~ '_action', {resourceName: resource.name, id: record.identifier, action: action.name}) }}"
                                              {% if action.name == 'dismiss' %}onsubmit="return confirm('Dismiss this message? This cannot be undone.');"{% endif %}
                                              class="d-inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('polysource_action') }}">
                                            <button type="submit"
                                                    class="btn btn-outline-{{ action.name == 'dismiss' ? 'danger' : 'secondary' }}"
                                                    data-polysource-action="inline-{{ action.name }}"
                                                    data-polysource-record="{{ record.identifier }}">
                                                {{ action.label }}
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ fields|length + 1 }}" class="text-center text-body-secondary py-4">
                                No records.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include '@Polysource/paginator.html.twig' with {page: page, context: context} only %}
{% endblock %}
