{% extends polysource_layout|default('@Polysource/layout.html.twig') %}

{% block title %}{{ resource.label }}{% endblock %}

{% block content %}
    {% set route_prefix = 'polysource_' ~ resource.name|replace({'-': '_'}) %}

    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-0">{{ resource.label }}</h1>
            <small class="text-body-secondary" data-polysource-resource="{{ resource.name }}">
                {{ resource.name }}
            </small>
        </div>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            {# `saved_views_dropdown` is owned by
             # `polysource/filter::SavedViewExtension` (since v0.1.4),
             # a hard require of `polysource/symfony-bundle`. The
             # `polysource_saved_views_supported()` gate is kept for
             # backward compat with v0.1.x templates but always
             # returns true now — feel free to drop the conditional
             # in host overrides if you're targeting v0.1.4+ only. #}
            {{ saved_views_dropdown(resource.name) }}

            {# The Filters button + modal markup live in this partial.
             # Rendered here so the trigger sits next to saved-views
             # and bulk actions, like EA's filter button. #}
            {% include '@Polysource/_filters_form.html.twig' ignore missing %}

            {% if bulk_actions is defined and bulk_actions|length > 0 %}
                <div class="d-flex gap-2 flex-wrap" data-polysource-bulk-toolbar>
                    {% for action in bulk_actions %}
                        <form method="POST"
                              action="{{ path(route_prefix ~ '_bulk_action', {resourceName: resource.name, action: action.name}) }}"
                              onsubmit="return confirm('{{ (action.confirmation ?: 'Run “' ~ action.label ~ '” on every record? This cannot be undone.')|e('js') }}');"
                              class="d-inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('polysource_action') }}">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-{{ action.cssVariant|default('primary') }}"
                                    data-polysource-action="bulk-{{ action.name }}">
                                {{ action.label }}
                            </button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </header>

    {% include '@Polysource/_filter_chips.html.twig' ignore missing %}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        {% for field in fields %}
                            <th scope="col">{{ field.label|default(field.property) }}</th>
                        {% endfor %}
                        <th scope="col" class="text-end">&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in page.items %}
                        {# Per-record action views (since v1.1.0): the
                         # controller pre-filters with the record as
                         # voter subject + populated isDisplayed()
                         # context. `inline_actions` (resource-level)
                         # remains the fallback for host controllers
                         # or overrides that don't pass the map. #}
                        {% set row_actions = record_actions is defined
                            ? (record_actions[record.identifier] ?? [])
                            : inline_actions %}
                        {# Named blocks (since v1.1.0) so a host can
                         # override one row concern without copying
                         # the whole `content` block. Blocks inside
                         # the for-loop re-render per row with the
                         # loop variables in scope. #}
                        {% block table_body_row %}
                        <tr>
                            {% block table_row_cells %}
                            {% for field in fields %}
                                <td>
                                    {% include field.template|default('@Polysource/field/generic.html.twig')
                                        with {value: record.get(field.property), field: field, record: record}
                                        only
                                    %}
                                </td>
                            {% endfor %}
                            {% endblock table_row_cells %}
                            <td class="text-end">
                                {% block table_row_actions %}
                                <div class="btn-group btn-group-sm" role="group">
                                    {% if row_details is defined and row_details[record.identifier]|default(false) %}
                                        {# Expandable row detail (v1.1.0). Real
                                         # link per ADR-027: without JS it opens
                                         # the standalone panel page; the
                                         # Stimulus controller upgrades it to
                                         # in-place expansion. #}
                                        {% set polysource_rd_url = path(route_prefix ~ '_detail_panel', {resourceName: resource.name, id: record.identifier}) %}
                                        <a href="{{ polysource_rd_url }}"
                                           class="btn btn-outline-secondary polysource-row-detail-toggle"
                                           role="button"
                                           aria-expanded="false"
                                           aria-label="{{ 'polysource.row_detail.expand'|trans({}, 'Polysource') }}"
                                           data-controller="polysource--row-details"
                                           data-polysource--row-details-url-value="{{ polysource_rd_url }}?fragment=1"
                                           data-polysource--row-details-expand-label-value="{{ 'polysource.row_detail.expand'|trans({}, 'Polysource') }}"
                                           data-polysource--row-details-collapse-label-value="{{ 'polysource.row_detail.collapse'|trans({}, 'Polysource') }}"
                                           data-polysource--row-details-loading-label-value="{{ 'polysource.row_detail.loading'|trans({}, 'Polysource') }}"
                                           data-polysource--row-details-error-label-value="{{ 'polysource.row_detail.error'|trans({}, 'Polysource') }}"
                                           data-polysource--row-details-retry-label-value="{{ 'polysource.row_detail.retry'|trans({}, 'Polysource') }}"
                                           data-action="polysource--row-details#toggle"
                                           data-polysource-action="row-detail"
                                           data-polysource-record="{{ record.identifier }}">
                                            <span aria-hidden="true" data-polysource--row-details-target="icon">▸</span>
                                        </a>
                                    {% endif %}
                                    <a href="{{ path(route_prefix ~ '_detail', {resourceName: resource.name, id: record.identifier}) }}"
                                       class="btn btn-outline-secondary"
                                       data-polysource-action="detail">
                                        {{ 'polysource.chrome.detail'|trans({}, 'Polysource') }}
                                    </a>
                                    {% for action in row_actions %}
                                        <form method="POST"
                                              action="{{ path(route_prefix ~ '_action', {resourceName: resource.name, id: record.identifier, action: action.name}) }}"
                                              {% if action.confirmation %}onsubmit="return confirm('{{ action.confirmation|e('js') }}');"{% endif %}
                                              class="d-inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('polysource_action') }}">
                                            <button type="submit"
                                                    class="btn btn-outline-{{ action.cssVariant|default('secondary') }}"
                                                    data-polysource-action="inline-{{ action.name }}"
                                                    data-polysource-record="{{ record.identifier }}">
                                                {{ action.label }}
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                                {% endblock table_row_actions %}
                            </td>
                        </tr>
                        {% endblock table_body_row %}
                    {% else %}
                        <tr>
                            <td colspan="{{ fields|length + 1 }}" class="text-center text-body-secondary py-4">
                                {{ 'polysource.chrome.no_records'|trans({}, 'Polysource') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include '@Polysource/paginator.html.twig' with {page: page, context: context} only %}
{% endblock %}
