{# EA-style modal: a "Filters" button in the page header opens a
 # Bootstrap modal containing one row per declared filter (label +
 # operator hidden + value input). The form submits via GET to the
 # index route. AdminContextResolver decodes the URL shape back
 # into FilterCriteria.
 #
 # Rendered as a sibling of the index table — the trigger button
 # is placed by index.html.twig in the header toolbar via the
 # `polysource_filters_button` macro at the bottom of this file. #}
{% set filter_defs = [] %}
{% for f in resource.configureFilters %}
    {% set filter_defs = filter_defs|merge([{
        'property': f.property,
        'label': f.label,
        'operators': f.supportedOperators,
    }]) %}
{% endfor %}

{% if filter_defs|length > 0 %}
    {% set chip_count = polysource_active_filters(context)|length %}

    {# Trigger button — placed inline at the call-site (index header). #}
    <button type="button"
            class="btn btn-secondary btn-labeled btn-labeled-right action-filters-button {{ chip_count > 0 ? 'action-filters-applied' }}"
            data-bs-toggle="modal"
            data-bs-target="#polysource-filters-modal"
            data-polysource-filters-trigger>
        <i class="fa fa-filter"></i>
        Filters{% if chip_count > 0 %} <span class="action-filters-button-count">({{ chip_count }})</span>{% endif %}
    </button>

    {# Modal — Bootstrap 5. Form wraps the entire modal-content so
     # the Apply button at the bottom submits the inputs above. #}
    <div class="modal fade" id="polysource-filters-modal" tabindex="-1" aria-labelledby="polysource-filters-modal-label" aria-hidden="true" data-polysource-filters-modal>
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form method="GET" data-polysource-filters-form>
                    <div class="modal-header">
                        <a href="{{ polysource_clear_filters_url(context) }}"
                           class="btn btn-link btn-sm text-decoration-none"
                           data-polysource-filters-clear>
                            <i class="fa fa-xmark"></i> Clear
                        </a>
                        <h5 class="modal-title flex-grow-1 text-center mb-0" id="polysource-filters-modal-label">
                            <i class="fa fa-filter"></i> Filters
                        </h5>
                        <button type="submit" class="btn btn-primary btn-sm" data-polysource-filters-apply>
                            <i class="fa fa-check"></i> Apply
                        </button>
                    </div>
                    <div class="modal-body">
                        {% for def in filter_defs %}
                            {% set current = context.query.filters[def.property]|default(null) %}
                            {% set current_value = current is null ? '' : (current.value is iterable ? current.value|join(', ') : current.value) %}
                            {% set is_active = current is not null %}
                            {% set operator = 'like' in def.operators ? 'like' : (def.operators|first|default('eq')) %}

                            <div class="filter-field mb-3 pb-3 border-bottom" data-filter-property="{{ def.property }}">
                                <label class="form-check d-flex align-items-center gap-2 mb-2">
                                    <input type="checkbox"
                                           class="form-check-input filter-checkbox"
                                           name="filter[{{ def.property }}][_enabled]"
                                           value="1"
                                           {% if is_active %}checked{% endif %}
                                           data-polysource-filter-checkbox>
                                    <strong>{{ def.label }}</strong>
                                </label>
                                <div class="d-flex gap-2 align-items-center" data-polysource-filter-inputs>
                                    <select name="filter[{{ def.property }}][op]" class="form-select form-select-sm" style="max-width: 8rem">
                                        {% for op in def.operators %}
                                            <option value="{{ op }}" {{ op == operator ? 'selected' }}>{{ op }}</option>
                                        {% endfor %}
                                    </select>
                                    <input type="text"
                                           name="filter[{{ def.property }}][value]"
                                           value="{{ current_value }}"
                                           class="form-control form-control-sm"
                                           placeholder="value">
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# Tiny shim mirroring EA's #createFilterToggles auto-check
     # behaviour: tick the matching .filter-checkbox the moment the
     # user touches the value/operator inputs in the same field, and
     # strip the disabled filter slices from the URL on submit so an
     # unchecked field doesn't leak into the query string. #}
    <script>
    (function () {
        const init = () => {
            const modal = document.getElementById('polysource-filters-modal');
            if (!modal || modal.dataset.polysourceBound === '1') return;
            modal.dataset.polysourceBound = '1';

            const form = modal.querySelector('form[data-polysource-filters-form]');
            if (!form) return;

            // Auto-tick the checkbox of any field whose value/operator
            // input gets touched. Mirrors EA's UX expectation.
            form.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                if (target.matches('.filter-checkbox')) return;
                const field = target.closest('.filter-field');
                if (!field) return;
                const checkbox = field.querySelector('.filter-checkbox');
                if (checkbox && !checkbox.checked) checkbox.checked = true;
            });

            // On submit: drop the inputs of every unchecked field so
            // the URL stays clean (`?filter[X][value]=foo` only when
            // X is enabled).
            form.addEventListener('submit', () => {
                form.querySelectorAll('.filter-field').forEach((field) => {
                    const checkbox = field.querySelector('.filter-checkbox');
                    if (checkbox && !checkbox.checked) {
                        field.querySelectorAll('input:not(.filter-checkbox), select').forEach((el) => {
                            el.disabled = true;
                        });
                    }
                });
            });
        };
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    </script>
{% endif %}
