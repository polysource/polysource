{# polysource/search — Cmd+K palette overlay (empty shell).
   The Stimulus controller `polysource--search--cmdk` mounts here,
   listens for Cmd+K / Ctrl+K / "/" globally, opens the dialog,
   debounces the input, and fetches GET /admin/search?q=.
#}
<div class="polysource-search-palette"
     data-controller="polysource--search--cmdk"
     data-polysource--search--cmdk-endpoint-value="/admin/search"
     data-polysource--search--cmdk-debounce-value="150">

    <div class="polysource-search-palette-overlay"
         data-polysource--search--cmdk-target="overlay"
         data-action="click->polysource--search--cmdk#close"
         hidden></div>

    <div class="polysource-search-palette-dialog"
         role="dialog"
         aria-label="{{ 'polysource.search.palette.aria_label'|trans({}, 'PolysourceSearch') }}"
         data-polysource--search--cmdk-target="dialog"
         hidden>

        <input type="search"
               class="polysource-search-palette-input"
               placeholder="{{ 'polysource.search.palette.placeholder'|trans({}, 'PolysourceSearch') }}"
               data-polysource--search--cmdk-target="input"
               data-action="input->polysource--search--cmdk#queryChanged
                            keydown->polysource--search--cmdk#keydown"
               autocomplete="off"
               spellcheck="false">

        <ul class="polysource-search-palette-results"
            role="listbox"
            data-polysource--search--cmdk-target="results"></ul>

        <div class="polysource-search-palette-empty text-muted small"
             data-polysource--search--cmdk-target="empty">
            {{ 'polysource.search.palette.empty_state'|trans({}, 'PolysourceSearch') }}
        </div>

        <div class="polysource-search-palette-hint text-muted small">
            <kbd>↑</kbd><kbd>↓</kbd> {{ 'polysource.search.palette.hint.navigate'|trans({}, 'PolysourceSearch') }} · <kbd>↵</kbd> {{ 'polysource.search.palette.hint.open'|trans({}, 'PolysourceSearch') }} · <kbd>Esc</kbd> {{ 'polysource.search.palette.hint.close'|trans({}, 'PolysourceSearch') }}
        </div>
    </div>
</div>
