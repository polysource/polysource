includes:
    - phpstan-baseline.neon

parameters:
    level: max

    # ADR-015: lock baseline at PHP 8.1. PHPStan flags any 8.2+
    # syntax (readonly class, true/false/null literal types, DNF, …)
    # so we never accidentally regress to a feature unavailable on
    # the supported PHP minimum.
    phpVersion: 80100

    paths:
        - packages

    excludePaths:
        analyse:
            - packages/*/tests/Functional/App/var/*
            - packages/*/tests/Functional/App/cache/*
            - packages/*/vendor/*

    treatPhpDocTypesAsCertain: false

    # PHPUnit-specific noise: ignore on test classes
    # Allow ignoreErrors patterns to become stale without failing CI.
    # The default behavior fails when an `ignoreErrors` entry doesn't
    # match any reported error — useful for catching unused baseline
    # entries, but disruptive for cross-PR shifts where tests are
    # refactored. We tolerate stale entries in exchange for being
    # able to refactor tests without orchestrating phpstan changes.
    # Specific entries below remain authoritative for the cases they
    # were created for; stale entries will be pruned in a dedicated
    # cleanup pass.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # EA's lifecycle events are generic over the entity type; constructing
        # them in tests with a non-generic-tagged class triggers
        # generics.unspecified at every callsite without adding signal —
        # the tests cover the subscriber's contract, not EA's typing.
        -
            identifier: argument.type
            paths:
                - packages/*/tests/Unit/EventListener/EasyAdminAuditSubscriberTest.php
        # OptionsResolver / AuditEntry context return array<string, mixed>;
        # asserting on specific keys in tests would otherwise need a wide
        # cast on every line.
        -
            identifier: offsetAccess.nonOffsetAccessible
            paths:
                - packages/*/tests/*
        # EA made CrudContext generic during the 5.x line; the docblock
        # follows the newer stubs (the pinned CI matrix), while local
        # platforms resolving EA 5.0.x see it as non-generic. Version-
        # dependent by nature — reportUnmatchedIgnoredErrors is off, so
        # this entry is harmless where the error doesn't occur.
        -
            identifier: generics.notGeneric
            paths:
                - packages/easyadmin-filter-bridge/tests/Unit/EventListener/FilterFormThemeRegistrationSubscriberTest.php
    # Inline strict-rules level (cf. phpstan/phpstan-strict-rules)
    # Provided by phpstan/extension-installer auto-loading
    bootstrapFiles: []
