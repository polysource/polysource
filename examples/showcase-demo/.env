# Polysource Showcase Demo — environment defaults
#
# All overridable via .env.local (gitignored). The values here are the
# baseline assumed by docker-compose.yml — change them only if you know
# what you're doing.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=showcase-demo-secret-rotated-on-prod
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://shopco:shopco@postgres:5432/shopco?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=default
MESSENGER_FAILED_DSN=doctrine://default?queue_name=failed
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###

###> meilisearch ###
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=showcase-meili-master-key
###< meilisearch ###

###> minio (s3-compatible) ###
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=shopco
S3_ACCESS_KEY=shopcoadmin
S3_SECRET_KEY=shopcoadmin-secret
S3_USE_PATH_STYLE=1
###< minio ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:8084/.well-known/mercure
MERCURE_JWT_SECRET=showcase-mercure-jwt-secret-32-chars-min-needed-here
###< symfony/mercure-bundle ###

###> wiremock (microservices simulation) ###
PAYMENT_SERVICE_URL=http://wiremock:8080
SHIPPING_SERVICE_URL=http://wiremock:8080
NOTIFICATIONS_SERVICE_URL=http://wiremock:8080
###< wiremock ###

###> showcase ###
SHOWCASE_ADMIN_EMAIL=admin@shop.co
SHOWCASE_OPS_EMAIL=ops@shop.co
SHOWCASE_VIEWER_EMAIL=viewer@shop.co
SHOWCASE_DEFAULT_PASSWORD=shopco
###< showcase ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8084
###< symfony/routing ###
