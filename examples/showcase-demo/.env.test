# test env overrides — kept minimal so Phase A bootstrap stays simple.
APP_ENV=test
APP_DEBUG=0
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
DATABASE_URL="postgresql://shopco:shopco@postgres:5432/shopco?serverVersion=17&charset=utf8"

###> symfony/panther ###
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
PANTHER_NO_SANDBOX=1
# Remote Selenium Chromium — see the `chrome` service in docker-compose.yml.
# Selenium reaches the showcase via the internal nginx hostname.
PANTHER_EXTERNAL_BASE_URI=http://nginx
PANTHER_SELENIUM_REMOTE_URL=http://chrome:4444/wd/hub
###< symfony/panther ###
