{% extends 'base.html.twig' %}

{% block title %}ShopCo — Dashboard{% endblock %}

{% block body %}
<nav class="shopco-navbar p-3 mb-4">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand fw-semibold" href="{{ path('app_home') }}">ShopCo</a>
        <div class="d-flex align-items-center gap-3">
            <a class="btn btn-sm btn-outline-light" href="/admin">Open EA admin</a>
            <span class="small">{{ app.user.userIdentifier }}</span>
            <a class="btn btn-sm btn-outline-light" href="{{ path('app_logout') }}">Sign out</a>
        </div>
    </div>
</nav>

<div class="container">
    <div class="d-flex align-items-center justify-content-end mb-3">
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm" href="/admin/polysource/failed-messages">Failed messages</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/polysource/bulk-jobs">Bulk jobs</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/polysource/audit-log">Audit log</a>
        </div>
    </div>

    {# render_dashboard outputs its own h1 from Dashboard::title.
       We keep the toolbar above it instead of doubling the heading. #}
    {{ render_dashboard('home') }}
</div>
{% endblock %}
