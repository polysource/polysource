{# EA layout override — opt out of Turbo on EA pages.
 #
 # EA bundles its `app.js` as a `<script>` in `<head>` and binds
 # `DOMContentLoaded` to instantiate `new App()` (which calls
 # `#createFilters()`, removes `class="disabled"` on the Filters
 # button, and binds the click→fetch→modal handler). Turbo replaces
 # `<body>` on navigation without re-firing `DOMContentLoaded`, so
 # the filters button stays disabled and clicking opens an empty
 # modal because no fetch handler is bound.
 #
 # Until EA ships a `turbo:load` hook, we make EA pages do full
 # reloads: `data-turbo="false"` on `<body>` tells Turbo to skip
 # interception. The non-EA pages (Polysource resources) still get
 # the SPA-like Turbo experience.
 #}
{% extends '@!EasyAdmin/layout.html.twig' %}

{% block body_attr %}data-turbo="false"{% endblock %}

{# EA's bundled CSS is rendered first (block head_stylesheets) and
 # then `addAssetMapperEntry('app')` injects the host importmap CSS
 # via block head_javascript / importmap — including standalone
 # Bootstrap 5, whose Reboot overrides EA's tighter resets
 # (underlined links, plain modal/dropdown chrome, button look).
 # We re-include EA's app.css in the LAST head block
 # (configured_head_contents) so it lands after the importmap CSS
 # links and the cascade flips: EA wins. #}
{% block configured_head_contents %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('app.css', ea.assets.defaultAssetPackageName) }}">
{% endblock %}
