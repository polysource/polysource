<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ShopCo — Polysource Showcase{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {# Polysource Cmd+K search palette — Stimulus controller binds
       Cmd+K / Ctrl+K / "/" hotkeys globally. Rendered only when
       authenticated. #}
    {% if app.user is defined and app.user is not null %}
        {{ polysource_search_palette() }}
    {% endif %}
</body>
</html>
