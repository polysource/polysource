{# Showcase override for @Polysource/layout.html.twig.
 #
 # Reuses EA's actual stylesheet and structural HTML (sidebar, main-
 # header, content-wrapper, content-top) so a Polysource page looks
 # indistinguishable from an EA page. The asset package
 # `easyadmin.assets.package` is registered by `easycorp/easyadmin-bundle`
 # and resolves to `/bundles/easyadmin/<file>` with proper hash
 # versioning — no need for the `ea` AdminContext to be available.
 #
 # The sidebar items are hardcoded here on purpose: the EA menu lives
 # in DashboardController::configureMenuItems() (PHP-side); a runtime
 # bridge would couple the two systems for marginal value. Keep this
 # in sync manually when you add a CRUD controller or Polysource
 # resource.
 #
 # Activated via `polysource.layout_template:` in services.yaml.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" data-turbo="false">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{{ resource.label|default('Admin') }} — ShopCo{% endblock %}</title>

    {# EA's compiled stylesheet — gives us the sidebar, topbar, table,
     # form, and dropdown looks for free. Versioned via EA's manifest. #}
    <link rel="stylesheet" href="{{ asset('app.css', 'easyadmin.assets.package') }}">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css"
          crossorigin="anonymous">
    {% block stylesheets %}{% endblock %}
</head>
<body class="ea ea-index"
      data-ea-content-width="normal"
      data-ea-sidebar-width="normal"
      data-ea-dark-scheme-is-enabled="false"
      data-ea-default-color-scheme="light"
      data-ea-icon-set="fontAwesome"
      data-ea-icon-prefix="">

    {# EA's page-layout.js wires the responsive sidebar toggle, the
     # search box collapse, and the dropdown menus. Loading it from
     # the same asset package keeps the markup behaving exactly like
     # an EA page. #}
    <script src="{{ asset('page-layout.js', 'easyadmin.assets.package') }}"></script>

    <div class="wrapper">
        <aside class="sidebar">
            <div class="sidebar-wrapper">
                <header class="main-header">
                    <nav class="navbar" role="navigation">
                        <div id="header-logo">
                            <a class="logo" title="ShopCo admin" href="/admin">
                                <span class="logo-custom">
                                    <span class="fw-semibold">ShopCo</span>
                                    <span class="text-muted">admin</span>
                                </span>
                            </a>
                        </div>
                    </nav>
                </header>

                <nav id="main-menu">
                    {% set current = resource.name|default('') %}
                    <ul class="menu">
                        <li class="menu-item">
                            <a href="/admin" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-house"></i></span>
                                <span class="menu-item-label position-relative">Home</span>
                            </a>
                        </li>

                        <li class="menu-header">
                            <span class="menu-header-contents">
                                <span class="menu-item-label position-relative">Catalog</span>
                            </span>
                        </li>
                        <li class="menu-item">
                            <a href="/admin?routeName=admin&crudControllerFqcn=App%5CController%5CAdmin%5CProductCrudController&crudAction=index" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-box"></i></span>
                                <span class="menu-item-label position-relative">Products</span>
                            </a>
                        </li>

                        <li class="menu-header">
                            <span class="menu-header-contents">
                                <span class="menu-item-label position-relative">Sales</span>
                            </span>
                        </li>
                        <li class="menu-item">
                            <a href="/admin?routeName=admin&crudControllerFqcn=App%5CController%5CAdmin%5COrderCrudController&crudAction=index" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-shopping-cart"></i></span>
                                <span class="menu-item-label position-relative">Orders</span>
                            </a>
                        </li>
                        <li class="menu-item">
                            <a href="/admin?routeName=admin&crudControllerFqcn=App%5CController%5CAdmin%5CRefundCrudController&crudAction=index" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-rotate-left"></i></span>
                                <span class="menu-item-label position-relative">Refunds</span>
                            </a>
                        </li>
                        <li class="menu-item">
                            <a href="/admin?routeName=admin&crudControllerFqcn=App%5CController%5CAdmin%5CCustomerCrudController&crudAction=index" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-user"></i></span>
                                <span class="menu-item-label position-relative">Customers</span>
                            </a>
                        </li>

                        <li class="menu-header">
                            <span class="menu-header-contents">
                                <span class="menu-item-label position-relative">Polysource Standalone</span>
                            </span>
                        </li>
                        <li class="menu-item {{ current == 'failed-messages' ? 'active' }}">
                            <a href="/admin/polysource/failed-messages" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-bug"></i></span>
                                <span class="menu-item-label position-relative">Failed messages</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 'login-attempts' ? 'active' }}">
                            <a href="/admin/polysource/login-attempts" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-key"></i></span>
                                <span class="menu-item-label position-relative">Login attempts</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 'audit-log' ? 'active' }}">
                            <a href="/admin/polysource/audit-log" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-clipboard-list"></i></span>
                                <span class="menu-item-label position-relative">Audit log</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 'bulk-jobs' ? 'active' }}">
                            <a href="/admin/polysource/bulk-jobs" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-tasks"></i></span>
                                <span class="menu-item-label position-relative">Bulk jobs</span>
                            </a>
                        </li>

                        <li class="menu-header">
                            <span class="menu-header-contents">
                                <span class="menu-item-label position-relative">Adapter resources</span>
                            </span>
                        </li>
                        <li class="menu-item {{ current == 'cache-keys' ? 'active' }}">
                            <a href="/admin/polysource/cache-keys" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-bolt"></i></span>
                                <span class="menu-item-label position-relative">Redis cache</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 's3-files' ? 'active' }}">
                            <a href="/admin/polysource/s3-files" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-folder-open"></i></span>
                                <span class="menu-item-label position-relative">S3 files</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 'microservices' ? 'active' }}">
                            <a href="/admin/polysource/microservices" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-cubes"></i></span>
                                <span class="menu-item-label position-relative">Microservices</span>
                            </a>
                        </li>
                        <li class="menu-item {{ current == 'search-index' ? 'active' }}">
                            <a href="/admin/polysource/search-index" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-magnifying-glass"></i></span>
                                <span class="menu-item-label position-relative">Search index</span>
                            </a>
                        </li>

                        <li class="menu-item">
                            <a href="/logout" class="menu-item-contents">
                                <span class="icon menu-icon"><i class="fa fa-arrow-right-from-bracket"></i></span>
                                <span class="menu-item-label position-relative">Sign out</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <section class="main-content">
            <aside class="content-top">
                <div class="content-search">
                    <span class="text-body-secondary small">
                        {% if app.user is defined and app.user is not null %}
                            Signed in as <strong>{{ app.user.userIdentifier }}</strong>
                        {% endif %}
                    </span>
                </div>
            </aside>

            <div class="content-wrapper">
                <article class="content">
                    {% block flash_messages %}
                        {% include '@Polysource/_flash.html.twig' ignore missing %}
                    {% endblock %}

                    {% block content_header %}{% endblock %}

                    <section id="main" class="content-body">
                        {% block content %}{% endblock %}
                    </section>

                    {% block content_footer %}{% endblock %}
                </article>
            </div>
        </section>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
