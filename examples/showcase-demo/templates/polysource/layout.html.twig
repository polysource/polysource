{# Showcase override for @Polysource/layout.html.twig.
 #
 # Reuses EA's actual stylesheet and structural HTML (sidebar, main-
 # header, content-wrapper, content-top) so a Polysource page looks
 # indistinguishable from an EA page. The asset package
 # `easyadmin.assets.package` is registered by `easycorp/easyadmin-bundle`
 # and resolves to `/bundles/easyadmin/<file>` with proper hash
 # versioning — no need for the `ea` AdminContext to be available.
 #
 # The sidebar items are hardcoded here on purpose: the EA menu lives
 # in DashboardController::configureMenuItems() (PHP-side); a runtime
 # bridge would couple the two systems for marginal value. Keep this
 # in sync manually when you add a CRUD controller or Polysource
 # resource.
 #
 # Activated via `polysource.layout_template:` in services.yaml.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{{ resource.label|default('Admin') }} — ShopCo{% endblock %}</title>

    {# Order matters: full Bootstrap FIRST, then EA's app.css so EA
     # wins the cascade on its tighter resets (links not underlined,
     # modal/dropdown styling intact). Bootstrap is linked explicitly
     # here — it used to travel with the importmap, but that also
     # injected it AFTER EA's css on EA CRUD pages where the order is
     # EA-first, breaking button/badge contrast since EA 5.5's
     # restyle. The importmap entry was removed; each non-EA-bundle
     # layout now links it in the position it needs. #}
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap/dist/css/bootstrap.min.css') }}">
    {{ importmap('app') }}

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css"
          crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('app.css', 'easyadmin.assets.package') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="ea ea-index"
      data-turbo="false"
      data-ea-content-width="normal"
      data-ea-sidebar-width="normal"
      data-ea-dark-scheme-is-enabled="false"
      data-ea-default-color-scheme="light"
      data-ea-icon-set="fontAwesome"
      data-ea-icon-prefix="">

    {# EA's bundled JS — page-layout (sidebar/responsive),
     # page-color-scheme (dark/light toggle), and the main `app.js`
     # which wires the interactive parts (modals, dropdowns,
     # tooltips, action confirmations). Loading them all from the
     # same asset package keeps Polysource pages behaving exactly
     # like an EA page. #}
    <script src="{{ asset('page-layout.js', 'easyadmin.assets.package') }}"></script>
    <script src="{{ asset('page-color-scheme.js', 'easyadmin.assets.package') }}"></script>
    <script src="{{ asset('app.js', 'easyadmin.assets.package') }}"></script>

    <div class="wrapper">
        {# Sidebar — mirrors EasyAdmin 5.5's markup vocabulary
           (`ea-sidebar-*`). EA 5.5 renamed the sidebar classes from the
           5.0 `sidebar`/`menu`/`menu-item` set; keep this in sync with
           the rendered output of a real EA page when bumping EA. #}
        {% set current = resource.name|default('') %}
        {% set polysource_menu = [
            {label: null, items: [
                {label: 'Home', icon: 'fa-house', href: '/admin'},
            ]},
            {label: 'Catalog', items: [
                {label: 'Products', icon: 'fa-box', href: '/admin/product'},
            ]},
            {label: 'Sales', items: [
                {label: 'Orders', icon: 'fa-shopping-cart', href: '/admin/order'},
                {label: 'Refunds', icon: 'fa-rotate-left', href: '/admin/refund'},
                {label: 'Customers', icon: 'fa-user', href: '/admin/customer'},
            ]},
            {label: 'Polysource Standalone', items: [
                {label: 'Failed messages', icon: 'fa-bug', href: '/admin/polysource/failed-messages', slug: 'failed-messages'},
                {label: 'Login attempts', icon: 'fa-key', href: '/admin/polysource/login-attempts', slug: 'login-attempts'},
                {label: 'Audit log', icon: 'fa-clipboard-list', href: '/admin/polysource/audit-log', slug: 'audit-log'},
                {label: 'Bulk jobs', icon: 'fa-tasks', href: '/admin/polysource/bulk-jobs', slug: 'bulk-jobs'},
            ]},
            {label: 'Adapter resources', items: [
                {label: 'Redis cache', icon: 'fa-bolt', href: '/admin/polysource/cache-keys', slug: 'cache-keys'},
                {label: 'S3 files', icon: 'fa-folder-open', href: '/admin/polysource/s3-files', slug: 's3-files'},
                {label: 'Microservices', icon: 'fa-cubes', href: '/admin/polysource/microservices', slug: 'microservices'},
                {label: 'Search index', icon: 'fa-magnifying-glass', href: '/admin/polysource/search-index', slug: 'search-index'},
            ]},
            {label: null, items: [
                {label: 'Sign out', icon: 'fa-arrow-right-from-bracket', href: '/logout'},
            ]},
        ] %}
        <div class="sidebar-wrapper">
            <aside class="ea-sidebar">
                <header class="ea-sidebar-header">
                    <div id="header-logo" class="ea-sidebar-logo">
                        <a class="logo" title="ShopCo admin" href="/admin">
                            <span class="logo-custom">
                                <span class="fw-semibold">ShopCo</span>
                                <span class="text-muted">admin</span>
                            </span>
                        </a>
                    </div>
                </header>

                <nav class="ea-sidebar-content" id="main-menu">
                    {% for group in polysource_menu %}
                        <div class="ea-sidebar-group">
                            {% if group.label %}
                                <div class="ea-sidebar-group-label">
                                    <span class="ea-sidebar-group-label-text">{{ group.label }}</span>
                                </div>
                            {% endif %}
                            <ul class="ea-sidebar-group-items">
                                {% for item in group.items %}
                                    <li class="ea-sidebar-item{{ item.slug is defined and current == item.slug ? ' is-active' }}">
                                        <a class="ea-sidebar-item-link" href="{{ item.href }}">
                                            <span class="ea-sidebar-item-icon"><span class="icon"><i class="fa {{ item.icon }}"></i></span></span>
                                            <span class="ea-sidebar-item-label">{{ item.label }}</span>
                                        </a>
                                        <span class="ea-sidebar-item-tooltip" aria-hidden="true">{{ item.label }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </nav>
            </aside>
        </div>

        <section class="main-content">
            <aside class="content-top">
                <div class="content-search">
                    <span class="text-body-secondary small">
                        {% if app.user is defined and app.user is not null %}
                            Signed in as <strong>{{ app.user.userIdentifier }}</strong>
                        {% endif %}
                    </span>
                </div>
            </aside>

            <div class="content-wrapper">
                <article class="content">
                    {% block flash_messages %}
                        {% include '@Polysource/_flash.html.twig' ignore missing %}
                    {% endblock %}

                    {% block content_header %}{% endblock %}

                    <section id="main" class="content-body">
                        {% block content %}{% endblock %}
                    </section>

                    {% block content_footer %}{% endblock %}
                </article>
            </div>
        </section>
    </div>

    {# Cmd+K cross-resource search palette — included site-wide so
     # the hotkey works from every Polysource standalone page, not
     # just the home dashboard. The package's `@PolysourceSearch`
     # template is registered when polysource/search is installed. #}
    {% block search_palette %}
        {% include '@PolysourceSearch/_palette.html.twig' ignore missing %}
    {% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
