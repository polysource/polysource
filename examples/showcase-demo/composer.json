{
    "name": "polysource/showcase-demo",
    "description": "Polysource Admin — ShopCo SaaS showcase exercising all 15 packages (hero of v0.1.0 launch). See ADR-025.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "async-aws/simple-s3": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "league/flysystem-async-aws-s3": "^3.29",
        "meilisearch/meilisearch-php": "^1.13",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.20",
        "polysource/adapter-doctrine": "1.2.x-dev",
        "polysource/adapter-flysystem": "1.2.x-dev",
        "polysource/adapter-http": "1.2.x-dev",
        "polysource/adapter-meilisearch": "1.2.x-dev",
        "polysource/adapter-messenger": "1.2.x-dev",
        "polysource/adapter-redis": "1.2.x-dev",
        "polysource/audit": "1.2.x-dev",
        "polysource/bulk-async": "1.2.x-dev",
        "polysource/core": "1.2.x-dev",
        "polysource/easyadmin-filter-bridge": "1.2.x-dev",
        "polysource/filter": "1.2.x-dev",
        "polysource/search": "1.2.x-dev",
        "polysource/symfony-bundle": "1.2.x-dev",
        "polysource/twig-theme": "1.2.x-dev",
        "polysource/widgets": "1.2.x-dev",
        "polysource/workflow-bridge": "1.2.x-dev",
        "predis/predis": "^2.3",
        "symfony/asset": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/console": "^7.4",
        "symfony/doctrine-messenger": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/flex": "^2.5",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mercure-bundle": "^0.3",
        "symfony/messenger": "^7.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/stimulus-bundle": "^2.22",
        "symfony/string": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/ux-icons": "^2.22",
        "symfony/ux-turbo": "^2.22",
        "symfony/ux-twig-component": "^2.22",
        "symfony/validator": "^7.4",
        "symfony/workflow": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/extra-bundle": "^3.18",
        "twig/intl-extra": "^3.18",
        "twig/twig": "^3.18"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/maker-bundle": "^1.62",
        "symfony/panther": "^2.2",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/web-profiler-bundle": "^7.4",
        "zenstruck/foundry": "^2.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "doctrine/orm": "3.6.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        { "type": "path", "url": "../../packages/core",                    "options": { "versions": { "polysource/core":                    "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/symfony-bundle",          "options": { "versions": { "polysource/symfony-bundle":          "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/twig-theme",              "options": { "versions": { "polysource/twig-theme":              "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/filter",                  "options": { "versions": { "polysource/filter":                  "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/easyadmin-filter-bridge", "options": { "versions": { "polysource/easyadmin-filter-bridge": "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-messenger",       "options": { "versions": { "polysource/adapter-messenger":       "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-doctrine",        "options": { "versions": { "polysource/adapter-doctrine":        "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-redis",           "options": { "versions": { "polysource/adapter-redis":           "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-flysystem",       "options": { "versions": { "polysource/adapter-flysystem":       "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-http",            "options": { "versions": { "polysource/adapter-http":            "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/adapter-meilisearch",     "options": { "versions": { "polysource/adapter-meilisearch":     "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/audit",                   "options": { "versions": { "polysource/audit":                   "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/workflow-bridge",         "options": { "versions": { "polysource/workflow-bridge":         "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/widgets",                 "options": { "versions": { "polysource/widgets":                 "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/search",                  "options": { "versions": { "polysource/search":                  "1.2.x-dev" } } },
        { "type": "path", "url": "../../packages/bulk-async",              "options": { "versions": { "polysource/bulk-async":              "1.2.x-dev" } } }
    ],
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "runtime": {
            "use_putenv": true
        }
    }
}
