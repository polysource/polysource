<?xml version="1.0" encoding="UTF-8"?>

<!--
    PHPUnit configuration override used by CI's Panther step.

    The default phpunit.dist.xml is strict (failOnDeprecation +
    failOnNotice + failOnWarning) so the package matrix catches
    drift fast. Symfony Panther 2.x on Sf 7 emits ~10 unrelated
    framework-level deprecations + 1 "abstract class" PHPUnit
    runner warning per run — those would mask real test outcomes.

    This override keeps the same testsuite + bootstrap but removes
    the strict fail-on-* attributes for the Panther suite only.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
    >
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
