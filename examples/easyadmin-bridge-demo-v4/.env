# Polysource Messenger demo — default environment.
# Override via .env.local (gitignored) for local tweaks.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=demo-secret-not-for-production

# Doctrine — SQLite database in var/.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Messenger transports — both backed by Doctrine on the SQLite database.
# `async` is the regular working transport (unused in the demo since the
# seed command writes straight to `failed`). `failed` collects messages
# that exhausted their retry budget.
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async
MESSENGER_TRANSPORT_DSN_FAILED=doctrine://default?queue_name=failed

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###
