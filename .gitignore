/packages/*/tests/Functional/App/cache/
/packages/*/tests/Functional/App/log/

# Demo app artefacts
/examples/*/var/
/examples/*/vendor/
/examples/*/.env.local
/examples/*/.env.local.php
/examples/*/.env.*.local

# npm artefacts (Vitest, Playwright)
node_modules/
package-lock.json
/examples/*/public/assets/
/examples/*/assets/vendor/

# Playwright artefacts
/examples/*/tests/e2e/test-results/
/examples/*/playwright-report/

# IDE / editors
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Local IDE / agent / editor tooling — never committed. Contents are
# environment-specific and not part of the project surface.
/.claude/
/.claude-flow/
/.cursor/
/.idea/
/.vscode/
/.mcp.json
/.private-docs/

# Docker
/docker-compose.override.yml

# DDEV
/.ddev/.gitignore
/.ddev/db_snapshots/
/.ddev/import-db/
/.ddev/import.yaml
/.ddev/.global_commands/

# Local-only launch material — drafts of announcements + GH issue
# bodies prepared before tag day. Kept on the maintainer's machine,
# never published verbatim; per session memory the public repo
# stays clean of pre-launch sensitivity.
/.launch-drafts/
examples/showcase-demo/.claude-flow/
