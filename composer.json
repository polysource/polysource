{
    "name": "polysource/polysource",
    "description": "Symfony admin engine for resources beyond Doctrine: Messenger failed messages, feature flags, files, queues, external APIs, search indexes, webhooks and configuration resources.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "symfony",
        "admin",
        "admin-panel",
        "messenger",
        "datasource",
        "multi-source",
        "polysource"
    ],
    "homepage": "https://github.com/polysource/polysource",
    "support": {
        "issues": "https://github.com/polysource/polysource/issues",
        "source": "https://github.com/polysource/polysource"
    },
    "require": {
        "php": ">=8.2",
        "polysource/adapter-messenger": "^1.3@dev",
        "polysource/core": "^1.3@dev",
        "polysource/symfony-bundle": "^1.3@dev",
        "polysource/twig-theme": "^1.3@dev"
    },
    "require-dev": {
        "async-aws/simple-s3": "*",
        "easycorp/easyadmin-bundle": "^4.24 || ^5.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "league/flysystem": "^3.0",
        "league/flysystem-async-aws-s3": "^3.29",
        "league/flysystem-memory": "^3.0",
        "meilisearch/meilisearch-php": "^1.0",
        "nyholm/psr7": "^1.8",
        "openspout/openspout": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "polysource/adapter-doctrine": "^1.3@dev",
        "polysource/adapter-flysystem": "^1.3@dev",
        "polysource/adapter-http": "^1.3@dev",
        "polysource/adapter-meilisearch": "^1.3@dev",
        "polysource/adapter-redis": "^1.3@dev",
        "polysource/audit": "^1.3@dev",
        "polysource/bulk-async": "^1.3@dev",
        "polysource/easyadmin-filter-bridge": "^1.3@dev",
        "polysource/filter": "^1.3@dev",
        "polysource/search": "^1.3@dev",
        "polysource/widgets": "^1.3@dev",
        "polysource/workflow-bridge": "^1.3@dev",
        "predis/predis": "^2.2",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/mercure": "^0.6 || ^0.7 || ^0.8 || ^1.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "conflict": {
        "doctrine/orm": "3.6.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "polysource/adapter-doctrine": "1.3.x-dev",
                    "polysource/adapter-flysystem": "1.3.x-dev",
                    "polysource/adapter-http": "1.3.x-dev",
                    "polysource/adapter-meilisearch": "1.3.x-dev",
                    "polysource/adapter-messenger": "1.3.x-dev",
                    "polysource/adapter-redis": "1.3.x-dev",
                    "polysource/audit": "1.3.x-dev",
                    "polysource/bulk-async": "1.3.x-dev",
                    "polysource/core": "1.3.x-dev",
                    "polysource/easyadmin-filter-bridge": "1.3.x-dev",
                    "polysource/filter": "1.3.x-dev",
                    "polysource/search": "1.3.x-dev",
                    "polysource/symfony-bundle": "1.3.x-dev",
                    "polysource/twig-theme": "1.3.x-dev",
                    "polysource/widgets": "1.3.x-dev",
                    "polysource/workflow-bridge": "1.3.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polysource\\Core\\Tests\\": "packages/core/tests/",
            "Polysource\\Bundle\\Tests\\": "packages/symfony-bundle/tests/",
            "Polysource\\Adapter\\Doctrine\\Tests\\": "packages/adapter-doctrine/tests/",
            "Polysource\\Adapter\\Flysystem\\Tests\\": "packages/adapter-flysystem/tests/",
            "Polysource\\Adapter\\Http\\Tests\\": "packages/adapter-http/tests/",
            "Polysource\\Adapter\\Meilisearch\\Tests\\": "packages/adapter-meilisearch/tests/",
            "Polysource\\Adapter\\Messenger\\Tests\\": "packages/adapter-messenger/tests/",
            "Polysource\\Adapter\\Redis\\Tests\\": "packages/adapter-redis/tests/",
            "Polysource\\Audit\\Tests\\": "packages/audit/tests/",
            "Polysource\\BulkAsync\\Tests\\": "packages/bulk-async/tests/",
            "Polysource\\EasyAdminFilterBridge\\Tests\\": "packages/easyadmin-filter-bridge/tests/",
            "Polysource\\Search\\Tests\\": "packages/search/tests/",
            "Polysource\\Widgets\\Tests\\": "packages/widgets/tests/",
            "Polysource\\WorkflowBridge\\Tests\\": "packages/workflow-bridge/tests/"
        }
    }
}
